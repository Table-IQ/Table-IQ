{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TableIQ",
  "version": "0.8.15",
  "identifier": "ai.rhobots.tableiq",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TableIQ",
        "width": 1320,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "worker-src": "'self' blob:"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE": "licenses/NOTICE",
      "../LICENSE-EXCEPTIONS.md": "licenses/LICENSE-EXCEPTIONS.md",
      "../src/assets/engines/README.md": "licenses/src/assets/engines/README.md",
      "../src/assets/engines/LICENSE-devicon": "licenses/src/assets/engines/LICENSE-devicon",
      "../docs/brand/licenses/": "licenses/docs/brand/licenses/"
    },
    "fileAssociations": [
      {
        "ext": [
          "sql"
        ],
        "name": "SQL script",
        "description": "SQL script opened in the TableIQ editor",
        "mimeType": "application/sql",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
